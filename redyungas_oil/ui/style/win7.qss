/* ==========================================================================
   REDYUNGAS OIL — Hoja de estilos "Windows 7" (emulación para Linux).
   En Windows el estilo nativo "windowsvista" complementa esto. Replica el look
   de ZaraRadio v1.6.2: displays LCD verdes, badge rojo "Reproduciendo ahora",
   barra de herramientas clara, cartwall y transporte.
   ========================================================================== */

QMainWindow, QWidget {
    background-color: #f0f0f0;
    color: #000000;
    font-family: "Segoe UI", "Noto Sans", "Tahoma", sans-serif;
    font-size: 9pt;
}

/* ---- Barra de menús / herramientas ---- */
QMenuBar { background-color: #f0f0f0; }
QMenuBar::item:selected { background-color: #cde2f7; }
QMenu { background-color: #f7f7f7; border: 1px solid #b0b0b0; }
QMenu::item:selected { background-color: #cde2f7; }

QToolBar#mainToolbar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fbfbfb, stop:1 #e6e6e6);
    border-bottom: 1px solid #c4c4c4;
    spacing: 1px;
    padding: 1px;
}
QToolBar#mainToolbar QToolButton { font-size: 10pt; padding: 1px 2px; }
QToolBar#mainToolbar QToolButton:hover {
    background: #d6e9fb; border: 1px solid #a9cdf0; border-radius: 3px;
}

/* ---- Etiquetas de sección (gris pequeño) ---- */
QLabel#sectionTag { color: #6a6a6a; font-size: 8pt; }

/* ---- Badge rojo "Reproduciendo ahora" ---- */
QLabel#badgePlaying {
    background-color: #e23b2e; color: #ffffff; font-size: 8pt;
    padding: 1px 6px; border-radius: 2px;
}

/* ---- Displays de título (recuadro blanco hundido) ---- */
QFrame#titleDisplay {
    background-color: #ffffff;
    border: 1px solid #7f9db9;
    border-radius: 2px;
}
QLabel#titleText { color: #101010; font-size: 16pt; font-weight: bold; }

/* ---- LCDs verdes (tiempo restante / acaba a las) ---- */
QLabel#lcd {
    background-color: #061a06; color: #28e23a;
    font-family: "Consolas", "DejaVu Sans Mono", monospace;
    font-size: 22pt; font-weight: bold;
    border: 1px solid #0c3a0c; border-radius: 2px; padding: 0 8px;
}
QLabel#lcdSmall {
    background-color: #061a06; color: #28e23a;
    font-family: "Consolas", "DejaVu Sans Mono", monospace;
    font-size: 15pt; font-weight: bold;
    border: 1px solid #0c3a0c; border-radius: 2px; padding: 0 6px;
}

/* ---- Reloj + clima ---- */
QLabel#clockDate { color: #303030; font-size: 9pt; }
QLabel#clockTime { color: #101010; font-size: 14pt; font-weight: bold; }
QLabel#weather { color: #303030; font-size: 10pt; }

/* ---- Lista y tablas ---- */
QLabel#durTotal { color: #303030; font-size: 8pt; }
QTableWidget#playlist, QTreeWidget#eventsTable, QTableWidget#mentionsTable, QTreeView#fileTree {
    background-color: #ffffff;
    alternate-background-color: #f4f7fb;
    selection-background-color: #cde2f7;
    selection-color: #000000;
    border: 1px solid #a7a7a7;
}
QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fafafa, stop:1 #e4e4e4);
    border: 1px solid #c4c4c4; padding: 2px 4px; font-size: 8pt;
}

/* ---- Cartwall (9 cuñas) ---- */
QPushButton#cartButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fcfcfc, stop:1 #e9e9e9);
    border: 1px solid #b9b9b9; border-radius: 2px;
    text-align: left; padding: 2px 6px; color: #555555; font-size: 8pt;
}
QPushButton#cartButton:hover { background: #eef6ff; border-color: #9cc6ef; }
QSpinBox#cartBank { border: 1px solid #b0b0b0; }

/* ---- Transporte ---- */
QToolButton#transportButton {
    font-size: 15pt; font-weight: bold;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fdfdfd, stop:1 #ececec);
    border: 1px solid #bdbdbd; border-radius: 3px;
}
QToolButton#transportButton:hover { background: #eaf4ff; border-color: #9cc6ef; }
QToolButton#transportButton:pressed { background: #d6e9fb; }
QFrame#transportSep { color: #c4c4c4; }

QSlider#transportSlider::groove:horizontal,
QSlider#masterVolume::groove:vertical {
    background: #d8d8d8; border: 1px solid #b0b0b0; border-radius: 2px;
}
QSlider#transportSlider::groove:horizontal { height: 6px; }
QSlider#masterVolume::groove:vertical { width: 6px; }
QSlider::handle {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5aa0e0, stop:1 #2a6fb5);
    border: 1px solid #1c5894; border-radius: 2px;
}
QSlider#transportSlider::handle:horizontal { width: 12px; margin: -5px 0; }
QSlider#masterVolume::handle:vertical { height: 12px; margin: 0 -5px; }

/* ---- Branding y barra de estado ---- */
QLabel#brandLogo { font-size: 11pt; font-weight: bold; color: #b30000; padding: 0 6px; }
QLabel#secondaryCopy {
    color: #555555; font-size: 8pt;
    border: 1px solid #c4c4c4; border-radius: 2px; padding: 1px 5px; margin-right: 4px;
}
QStatusBar { background-color: #e8e8e8; }
QLabel#statusTime { color: #303030; font-family: "Consolas", monospace; padding: 0 8px; }

/* ---- Panel emisor "PUERTO" (estilo Opticodec) ---- */
QWidget#streamPanel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4a4a4a, stop:1 #3a3a3a);
    border-left: 1px solid #1b3e60;
}
QFrame#streamBanner {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7a2f8f, stop:1 #4a2f8f);
    border: 1px solid #2a1740; border-radius: 3px;
}
QLabel#streamBannerTitle { color: #ffffff; font-size: 15pt; font-weight: bold; letter-spacing: 1px; }
QLabel#streamBannerSub { color: #d9c7ff; font-size: 8pt; letter-spacing: 3px; }
QLabel#streamInfo { color: #dcdcdc; font-size: 8pt; }
QLabel#streamUrl { color: #9fd0ff; font-size: 8pt; }
QLabel#streamFoot { color: #9a9a9a; font-size: 7pt; font-style: italic; }
QLabel#streamStatusOff  { color: #c9c9c9; font-size: 9pt; font-weight: bold; }
QLabel#streamStatusOn   { color: #3ad14c; font-size: 9pt; font-weight: bold; }
QLabel#streamStatusWarn { color: #f4b400; font-size: 9pt; font-weight: bold; }
QWidget#streamPanel QLabel#sectionTag { color: #cdcdcd; font-size: 8pt; }
QLabel#gainReadout {
    color: #28e23a; background: #061a06; border: 1px solid #0c3a0c; border-radius: 2px;
    font-family: "Consolas", monospace; font-size: 8pt; padding: 1px 3px;
}
QPushButton#emitButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2faf4a, stop:1 #1d8f38);
    color: #ffffff; font-weight: bold; border: 1px solid #14672a; border-radius: 3px; padding: 4px;
}
QPushButton#emitButton:hover { background: #36c454; }
QPushButton#emitButton:disabled { background: #5a6a5c; color: #b9c4ba; border-color: #3a4a3c; }
QPushButton#stopEmitButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #d8483a, stop:1 #b5301f);
    color: #ffffff; font-weight: bold; border: 1px solid #7d1f14; border-radius: 3px; padding: 4px;
}
QPushButton#stopEmitButton:hover { background: #e2554a; }
QPushButton#stopEmitButton:disabled { background: #6a5a5a; color: #c4b9b9; border-color: #4a3a3a; }
QWidget#streamPanel QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #fbfbfb, stop:1 #e3e3e3);
    border: 1px solid #9a9a9a; border-radius: 3px; padding: 3px; font-size: 8pt;
}
QSlider#gainSlider::groove:horizontal {
    background: #2a2a2a; border: 1px solid #1a1a1a; border-radius: 2px; height: 6px;
}
QSlider#gainSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f0c000, stop:1 #c89800);
    border: 1px solid #8a6a00; border-radius: 2px; width: 12px; margin: -5px 0;
}
